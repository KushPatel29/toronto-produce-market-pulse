// Generated by build_powerbi_model.py from the same definitions as the TMDL model.
// Relationships (single direction, many-to-one):
//   fact_sales_price[item_id] -> dim_item[item_id]
//   fact_sales_price[segment_id] -> dim_segment[segment_id]
//   fact_sales_price[date_key] -> dim_date[date_key]
//   fact_market_price[item_id] -> dim_item[item_id]
//   fact_market_price[date_key] -> dim_date[date_key]
//   fact_shipments[item_id] -> dim_item[item_id]
//   fact_promotion[item_id] -> dim_item[item_id]

// ---- fact_sales_price ----

Revenue = SUMX ( fact_sales_price, fact_sales_price[sell_price] * fact_sales_price[cases] )

COGS = SUMX ( fact_sales_price, fact_sales_price[landed_cost] * fact_sales_price[cases] )

Gross Margin = [Revenue] - [COGS]

GM % = DIVIDE ( [Gross Margin], [Revenue] )

GM at Target =
    SUMX (
        fact_sales_price,
        fact_sales_price[sell_price] * fact_sales_price[cases] * fact_sales_price[target_margin]
    )

Target GM % = DIVIDE ( [GM at Target], [Revenue] )

Margin Variance = [Gross Margin] - [GM at Target]

Margin Gap (pts) = ( [GM %] - [Target GM %] ) * 100

Variance - Cost Timing =
    SUMX (
        fact_sales_price,
        fact_sales_price[cases] * ( fact_sales_price[prior_cost] - fact_sales_price[landed_cost] )
    )

Variance - Price Hold =
    SUMX (
        fact_sales_price,
        fact_sales_price[cases]
            * ( fact_sales_price[sell_price] * ( 1 - fact_sales_price[target_margin] ) - fact_sales_price[prior_cost] )
    )

Variance Check = ROUND ( [Margin Variance] - [Variance - Cost Timing] - [Variance - Price Hold], 2 )

Breach Rate =
    AVERAGEX (
        fact_sales_price,
        IF (
            1 - DIVIDE ( fact_sales_price[landed_cost], fact_sales_price[sell_price] )
                < fact_sales_price[target_margin] - 0.10,
            1,
            0
        )
    )

Price Changes = SUM ( fact_sales_price[price_changed] )

// ---- fact_market_price ----

Avg Terminal Price (CAD) = AVERAGE ( fact_market_price[terminal_cad] )

Terminal Price vs Prior Year =
    VAR cur = [Avg Terminal Price (CAD)]
    VAR py =
        CALCULATE (
            [Avg Terminal Price (CAD)],
            FILTER ( ALL ( dim_date ), dim_date[year] = MAX ( dim_date[year] ) - 1 ),
            VALUES ( dim_item[item_id] )
        )
    RETURN
        DIVIDE ( cur - py, py )

// ---- fact_shipments ----

Net Revenue = SUM ( fact_shipments[revenue] )

List Revenue = SUM ( fact_shipments[list_revenue] )

Discounts & Promotions = [List Revenue] - [Net Revenue]

Discount Rate = DIVIDE ( [Discounts & Promotions], [List Revenue] )

Shipment GM = SUM ( fact_shipments[gm] )

Shipment GM % = DIVIDE ( [Shipment GM], [Net Revenue] )

Cases Shipped = SUM ( fact_shipments[cases] )

Promo Share of Cases = DIVIDE ( CALCULATE ( [Cases Shipped], fact_shipments[promo] = TRUE () ), [Cases Shipped] )

PVM GM 2019 =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        GMA

PVM GM 2023 =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        SUMX ( t, [@gmb] )

PVM Volume =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        DIVIDE ( QB - QA, QA ) * GMA

PVM Mix =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        SUMX ( t, [@qb] * DIVIDE ( [@gma], [@qa] ) ) - DIVIDE ( QB, QA ) * GMA

PVM List Price =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        SUMX ( t, [@lrb] - [@qb] * DIVIDE ( [@lra], [@qa] ) )

PVM Discounts & Promotions =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        SUMX ( t, ( [@rb] - [@lrb] ) - [@qb] * DIVIDE ( [@ra] - [@lra], [@qa] ) )

PVM Cost =
    VAR a = 2019
    VAR b = 2023
    VAR t =
        ADDCOLUMNS (
            FILTER (
                VALUES ( fact_shipments[item_id] ),
                CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ) > 0
                    && CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ) > 0
            ),
            "@qa", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = a ),
            "@qb", CALCULATE ( SUM ( fact_shipments[cases] ), fact_shipments[year] = b ),
            "@gma", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = a ),
            "@gmb", CALCULATE ( SUM ( fact_shipments[gm] ), fact_shipments[year] = b ),
            "@lra", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = a ),
            "@lrb", CALCULATE ( SUM ( fact_shipments[list_revenue] ), fact_shipments[year] = b ),
            "@ra", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = a ),
            "@rb", CALCULATE ( SUM ( fact_shipments[revenue] ), fact_shipments[year] = b ),
            "@ca", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = a ),
            "@cb", CALCULATE ( SUM ( fact_shipments[cogs] ), fact_shipments[year] = b )
        )
    VAR QA = SUMX ( t, [@qa] )
    VAR QB = SUMX ( t, [@qb] )
    VAR GMA = SUMX ( t, [@gma] )
    RETURN
        - SUMX ( t, [@cb] - [@qb] * DIVIDE ( [@ca], [@qa] ) )

PVM Check = ROUND ( [PVM GM 2023] - [PVM GM 2019] - [PVM Volume] - [PVM Mix] - [PVM List Price] - [PVM Discounts & Promotions] - [PVM Cost], 2 )

// ---- fact_promotion ----

Promo Events = COUNTROWS ( fact_promotion )

Trade Spend = SUM ( fact_promotion[trade_spend] )

Net Incremental Margin = SUM ( fact_promotion[net_incremental_margin] )

Promo ROI = DIVIDE ( [Net Incremental Margin], [Trade Spend] )

Events Paid Back = COUNTROWS ( FILTER ( fact_promotion, fact_promotion[roi] > 0 ) )

Median Break-even Lift = MEDIAN ( fact_promotion[breakeven_uplift] )

Lift Estimate Error (pts) = AVERAGE ( fact_promotion[uplift_error_pts] )
