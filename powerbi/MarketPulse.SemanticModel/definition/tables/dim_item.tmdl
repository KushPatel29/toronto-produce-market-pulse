/// Basket item: category, unit, target margin and planned weekly cases.
table dim_item

	column item_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: item_id

	column item_name
		dataType: string
		summarizeBy: none
		sourceColumn: item_name

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column uom
		dataType: string
		summarizeBy: none
		sourceColumn: uom

	column target_margin
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: target_margin

	column weekly_cases
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: weekly_cases

	partition dim_item = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(SourceRoot, [RelativePath = "star_schema/dim_item.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"item_id", type text}, {"item_name", type text}, {"category", type text}, {"uom", type text}, {"target_margin", type number}, {"weekly_cases", type number}}, "en-US")
				in
				    Typed

